# Unity .gitignore - CRUCIBLE Honorable Souls

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]serSettings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio
.vs/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Mac files
.DS_Store

# Windows files
Thumbs.db
desktop.ini

# VS Code (keep settings folder but ignore caches)
.vscode/

# Claude Code session files
.specstory/
.claude/

# Other generated files
ignore.conf
# Plastic SCM state (unused), Unity crash recovery, and the ~700 MB Tripo character meshes (too big for GitHub without LFS)
.plastic/
/Assets/_Recovery/
/Assets/_Recovery.meta
/Assets/_project/Characters/*/Model/
/Assets/_project/Characters/*/Model.meta
/Assets/_project/Characters/_Unrigged/
/Assets/_project/Characters/_Unrigged.meta

# Blender auto-backups
*.blend1
*.blend2

# Tripo originals backed up by ArtSource/Blender/prep_character.py (hundreds of MB)
ArtSource/Characters/

# Animation pipeline probe outputs (Crucible > Debug, PlayProbe)
/ClipProbe*.txt
/PlayProbe*.txt
/ClipProbe.request
/ClipMap.request

# Generated animation masters (anim_rig.py rebuilds them from the body FBX) and Python cache
ArtSource/Blender/*_AnimMaster.blend
ArtSource/Blender/__pycache__/

# relay server dependencies
Server/node_modules/
Server/relay.log
Server/tunnel.log
Server/cf.log

# Mocap source videos (large) and the extracted landmark JSON
ArtSource/Mocap/raw/
ArtSource/Mocap/landmarks/
ArtSource/Mocap/models/
Server/cf.prev.log

# Throwaway scene CrucibleBuild builds from (one arena only); deleted when the build ends.
Assets/_project/Scenes/_build_temp.unity
Assets/_project/Scenes/_build_temp.unity.meta
