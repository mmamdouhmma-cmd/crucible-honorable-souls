    { "id": "musashi", "ja": "武蔵",       "en": "Musashi" },
    { "id": "partner", "ja": "稽古相手",   "en": "Partner" },
    { "id": "arima",   "ja": "有馬喜兵衛", "en": "Arima Kihei" },
